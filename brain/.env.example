# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Provider: "auto" (groq if a key is set, else mock), "groq", or "mock".
HIVEMIND_LLM_PROVIDER=auto

# Groq (OpenAI-compatible, fast free tier). Required when provider resolves to groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reflection-loop tuning (per-request overrides also accepted).
HIVEMIND_MAX_ITERATIONS=3
HIVEMIND_CONFIDENCE_THRESHOLD=0.75
HIVEMIND_LLM_TIMEOUT_S=30

# Retry transient LLM failures (rate limits, timeouts, 5xx) with backoff.
HIVEMIND_LLM_MAX_RETRIES=2
HIVEMIND_LLM_RETRY_BASE_S=0.5

# Log level for request logging (DEBUG/INFO/WARNING/ERROR).
HIVEMIND_LOG_LEVEL=INFO

# Multi-replica: a shared Postgres DSN backs the checkpointer (paused approvals)
# and incident memory so replicas share state. Leave empty for single-replica
# (in-memory / file / SQLite). A UTF-8 database is expected.
HIVEMIND_CHECKPOINT_DSN=
HIVEMIND_MEMORY_DSN=
